<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      PRIVACY HARDENING (Android conversion — Phase G)
      ================================================
      This app stores private financial records on the device.

        android:allowBackup="false"
            Stops Android's automatic cloud backup and device-to-device
            transfer of the app's data. Without this, the SQLite database
            (and therefore every transaction) would be copied to the user's
            Google Drive backup, which is not what "on-device only" means.

        android:usesCleartextTraffic="false"
            No plaintext HTTP. The app never talks to a server, and this
            makes that impossible to do by accident.

        android:fullBackupContent / android:dataExtractionRules
            Belt and braces for Android 12+ (dataExtractionRules) and
            Android 11 and below (fullBackupContent) — both exclude
            everything.

      The only permission requested is INTERNET, which the WebView needs for
      its own internal localhost scheme. No storage, camera, contacts,
      location or microphone permission is requested: the app writes into its
      own private directory and the user picks files with the system
      document picker (Storage Access Framework).
    -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <!--
      INTERNET is required by the Capacitor WebView, which serves the app
      from a local https://localhost origin. The app itself makes no network
      requests; the on-device database is the only data store.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
