# Database (SQLite via Prisma — file is created by `npx prisma migrate dev`)
DATABASE_URL="file:./dev.db"

# JWT
# ⚠️  The value below is a PLACEHOLDER and the server REFUSES to start with
#     it in production. Generate a unique secret:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Client URL (for CORS) — the exact origin of the SPA
CLIENT_URL="http://localhost:5173"

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info

# Set to "true" ONLY when the API is reachable exclusively through a reverse
# proxy you control. Otherwise a client can spoof X-Forwarded-For and defeat
# the rate limiter.
TRUST_PROXY=false
